# ---- App ----
APP_URL=http://localhost:3000            # public URL (Render: https://<service>.onrender.com)
# DATABASE_URL=postgres://...            # Render Postgres. Leave empty locally -> embedded PGlite in ./.data
ENABLE_SIMULATOR=true                     # web WhatsApp simulator at /chat (for judges)
# REDIS_URL=redis://...                  # Render Key Value (internal URL). Empty -> in-memory cost guard
DAILY_AI_LIMIT=150                        # max AI calls per UTC day across all users
# CRON_SECRET=                           # shared by the web service and the reconcile cron job (Render generates it)

# ---- PayPal (SANDBOX) — developer.paypal.com > Apps & Credentials ----
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=                        # after creating the webhook to $APP_URL/api/paypal/webhook
SANDBOX_BUYER_EMAIL=                      # optional: shown in the simulator for judges
SANDBOX_BUYER_PASSWORD=
SANDBOX_PAYEE_EMAIL=                      # optional: sandbox account for test payouts (defaults to the buyer)

# ---- Gemini (free key: https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- WhatsApp Cloud API (Meta) ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=                    # any random string; paste the same in Meta webhook config
WHATSAPP_APP_SECRET=                      # Meta app secret, for X-Hub-Signature-256 verification
WHATSAPP_DISPLAY_NUMBER=                  # bot number in international format, e.g. 15551234567
# WHATSAPP_REMINDER_TEMPLATE=pledge_reminder  # approved UTILITY template for reminders outside 24h ("off" disables)

# ---- AG Studio (45-day trial key from AG Grid) ----
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=

# ---- Evidence cards ----
# Every PayPal payment and payout gets an Ed25519-signed card, verifiable at /proof/<id>.
# 32-byte seed, base64 (openssl rand -base64 32). Without it a fixed development key is used
# and proof pages say so. Render generates one from render.yaml.
EVIDENCE_SIGNING_KEY=
